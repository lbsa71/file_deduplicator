{
  "name": "@photoflow/google-photos",
  "version": "0.3.1",
  "description": "Strict Google Photos protocol adapters, reconciliation rules, and passive capture tools",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/index.js",
    "./browser": "./src/browser.js",
    "./node": "./src/node.js",
    "./capture": "./src/capture.js",
    "./worker": "./src/worker.js",
    "./jobs": "./src/jobs.js",
    "./job-diagnostics": "./src/job-diagnostics.js",
    "./toolkit-pilot": "./src/toolkit-pilot.js",
    "./browser-journal": "./src/browser-journal.js",
    "./google-job-handlers": "./src/google-job-handlers.js"
  },
  "files": [
    "src",
    "dist/capture-extension",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:capture": "node tools/build-capture.js",
    "test:browser": "node tools/browser-smoke.mjs",
    "prepack": "npm run build:capture",
    "test:worker": "node tools/worker-smoke.mjs",
    "check:contracts": "node tools/sync-job-contracts.mjs --check"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "license": "MIT"
}
