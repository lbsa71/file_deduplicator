{
  "manifest_version": 3,
  "name": "PhotoFlow Google Photos",
  "version": "0.3.1",
  "description": "Run typed PhotoFlow Google Photos jobs with sanitized diagnostics and account-authorized pilots.",
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://photos.google.com/*",
    "https://photos.lbsa71.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Photos capture"
  },
  "minimum_chrome_version": "118"
}
